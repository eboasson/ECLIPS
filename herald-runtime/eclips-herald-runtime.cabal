cabal-version:      3.0
name:               eclips-herald-runtime
version:            0.1.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
extra-doc-files:    README.md
author:             Erik Boasson
maintainer:         Erik Boasson <eb@ilities.com>
copyright:          2026 Erik Boasson
synopsis:           Typed Herald runtime with application, peer, and Oracle TCP
description:
    A scoped STM runtime that exclusively owns one pure Herald kernel. It
    provides typed application, administration, peer, and outbound Oracle lanes
    plus a separate named component that composes them with EAPP, EPRP, and EORC
    TCP transport.
category:           Distributed

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods

library runtime-internal
  import:             warnings
  visibility:         private
  exposed-modules:
      Eclips.Herald.Runtime
      Eclips.Herald.Runtime.Connection
      Eclips.Herald.Runtime.Handler
      Eclips.Herald.Runtime.Ingress
      Eclips.Herald.Runtime.Oracle
      Eclips.Herald.Runtime.Trace
      Eclips.Herald.Runtime.Internal.Arbiter
      Eclips.Herald.Runtime.Internal.Connection
      Eclips.Herald.Runtime.Internal.Conformance
      Eclips.Herald.Runtime.Internal.Coordination
      Eclips.Herald.Runtime.Internal.GeneratorSeed
      Eclips.Herald.Runtime.Internal.Owner
      Eclips.Herald.Runtime.Internal.Recording
      Eclips.Herald.Runtime.Internal.Timer
      Eclips.Herald.Runtime.Internal.Trace
      Eclips.Herald.Runtime.Internal.Types
  hs-source-dirs:      src internal
  ghc-options:
      -threaded
  build-depends:
      base >=4.22 && <4.23,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      eclips-application-types >=0.1 && <0.2,
      eclips-domain >=0.1 && <0.2,
      eclips-public-types >=0.1 && <0.2,
      eclips-herald-core >=0.1 && <0.2,
      eclips-oracle-core >=0.1 && <0.2,
      eclips-protocol-admin >=0.1 && <0.2,
      eclips-protocol-application >=0.1 && <0.2,
      eclips-protocol-oracle >=0.1 && <0.2,
      eclips-protocol-peer >=0.1 && <0.2,
      eclips-raft-core >=0.1 && <0.2,
      entropy >=0.4.1.11 && <0.5,
      stm >=2.5.3 && <2.6
  default-language:    GHC2024

library
  import:             warnings
  reexported-modules:
      Eclips.Herald.Runtime,
