cabal-version: 3.0
name: eclips-profile02-proofs
version: 0.1.0.0
build-type: Simple
license: MIT
license-file: LICENSE
extra-doc-files: README.md
author: Erik Boasson
maintainer: Erik Boasson <eb@ilities.com>
copyright: 2026 Erik Boasson
synopsis: Independent profile 0.2 proof contracts for ECLIPS
description:
    Test-only finite reference models and counterexample schedules for singleton
    Raft, prepared-child attachment, repeated Herald retirement, join activation,
    joint-consensus leader loss, and object label generation/CAS replay. This development project imports no ECLIPS
    production package and exposes no runtime implementation.
category: Development

test-suite proof-contracts
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
      LabelGenerationContracts
      LifecycleContracts
      MembershipContracts
      RaftContracts
  default-language: GHC2024
  ghc-options:
      -rtsopts
      -with-rtsopts=-M768m
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods
  build-depends:
      base >=4.22 && <4.23,
      containers >=0.8 && <0.9,
      tasty >=1.5 && <1.6,
      tasty-hunit >=0.10 && <0.11,
      tasty-quickcheck >=0.11 && <0.12
