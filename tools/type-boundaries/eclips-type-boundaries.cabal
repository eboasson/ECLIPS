cabal-version: 3.0
name: eclips-type-boundaries
version: 0.1.0.0
build-type: Simple
license: MIT
license-file: LICENSE
extra-doc-files: README.md
author: Erik Boasson
maintainer: Erik Boasson <eb@ilities.com>
copyright: 2026 Erik Boasson
synopsis: Semantic public-client boundary checks for ECLIPS
description:
    A development-only GHC API checker for the compiled ECLIPS public surface,
    nominal roles, opaque representations, and external-client fixtures.
category: Development

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods
  default-language: GHC2024

library
  import: warnings
  exposed-modules:
      Eclips.TypeBoundaries
      Eclips.TypeBoundaries.Spec
      Eclips.TypeBoundaries.Surface
  other-modules:
      Eclips.TypeBoundaries.Ghc914
  hs-source-dirs: src
  build-depends:
      base >=4.22 && <4.23,
      bytestring >=0.12 && <0.13,
      directory >=1.3.8 && <1.4,
      filepath >=1.5.4 && <1.6,
      ghc >=9.14.1 && <9.15,
      ghc-boot >=9.14.1 && <9.15

executable eclips-type-boundaries
  import: warnings
  ghc-options: -rtsopts -with-rtsopts=-M768m
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.22 && <4.23,
      eclips-type-boundaries

test-suite type-boundaries-properties
  import: warnings
  ghc-options: -rtsopts -with-rtsopts=-M768m
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
      base >=4.22 && <4.23,
      eclips-type-boundaries,
      tasty >=1.5 && <1.6,
      tasty-hunit >=0.10 && <0.11,
      tasty-quickcheck >=0.11 && <0.12
