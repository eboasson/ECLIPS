cabal-version:      3.0
name:               eclips-herald-core
version:            0.1.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
extra-doc-files:    README.md
author:             Erik Boasson
maintainer:         Erik Boasson <eb@ilities.com>
copyright:          2026 Erik Boasson
synopsis:           Pure transition machinery for the networked Herald kernel
description:
    Pure profile-0.1 startup and transition machinery for the composed Herald
    state. It includes the eight application operations, retained direct private
    environments, controlled publication and forwarding, structural and alignment
    convergence, captured-membership disappearance and regular-sort retirement,
    live process/label/failure/disappearance Oracle workflows, contiguous control
    projection, peer discovery and resumable streams, generation-qualified
    dispatch, terminal-source repair, and irreversible non-voter isolation.
    Typed RPC facades expose admission and effect projection; leaf state,
    identities, sequencing, and atomic coordinators remain in one package-private
    implementation library.
category:           Distributed

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods

