cabal-version:      3.0
name:               eclips-public-types
version:            0.1.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
extra-doc-files:    README.md
author:             Erik Boasson
maintainer:         Erik Boasson <eb@ilities.com>
copyright:          2026 Erik Boasson
synopsis:           Deliberately public shared identity types for ECLIPS
description:
    Minimal globally shareable types that cross both semantic and application
    boundaries without exposing controlled or globally unique identities. Checked
    current-build serialization preserves their opaque structural invariants.
category:           Distributed

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods

library
  import:             warnings
  exposed-modules:
      Eclips.Public.Types.Diagnostic
      Eclips.Public.Types.ReceiptRetirement
      Eclips.Public.Types.SortCanonical
      Eclips.Public.Types.SortCatalogue
      Eclips.Public.Types.SortId
      Eclips.Public.Types.Timing
  hs-source-dirs:      src
  build-depends:
      base >=4.22 && <4.23,
      binary >=0.8.9 && <0.9,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      cereal >=0.5 && <0.6,
      cryptohash-sha256 >=0.11 && <0.12
  default-language:    GHC2024

test-suite public-types-properties
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  other-modules:
      ReceiptRetirementProperties
      SortIdProperties
      TimingProperties
  hs-source-dirs:      test
  ghc-options:
      -threaded
      -rtsopts
      "-with-rtsopts=-N4 -M768m"
  build-depends:
      base >=4.22 && <4.23,
      binary >=0.8.9 && <0.9,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      eclips-public-types,
      tasty >=1.5 && <1.6,
      tasty-hunit >=0.10 && <0.11,
      tasty-quickcheck >=0.11 && <0.12
  default-language:    GHC2024
