cabal-version:      3.0
name:               eclips-application-types
version:            0.1.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
extra-doc-files:    README.md
author:             Erik Boasson
maintainer:         Erik Boasson <eb@ilities.com>
copyright:          2026 Erik Boasson
synopsis:           Application-facing value and identity types for ECLIPS
description:
    Private-ID-bearing values, queries, current operations, results and rejections,
    structured descriptor drafts, startup access, and opaque process-local
    identifiers used at the application boundary. Current-build serialization is
    validated at refined carriers. This package deliberately contains no
    semantic-domain or global identity types.
category:           Distributed

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods

library
  import:             warnings
  exposed-modules:
      Eclips.Application.Types.Access
      Eclips.Application.Types.Forward
      Eclips.Application.Types.Identity
      Eclips.Application.Types.Label
      Eclips.Application.Types.Lifecycle
      Eclips.Application.Types.Lifetime
      Eclips.Application.Types.NewId
      Eclips.Application.Types.Operation
      Eclips.Application.Types.Query
      Eclips.Application.Types.Rejection
      Eclips.Application.Types.Result
      Eclips.Application.Types.SortDescriptor
      Eclips.Application.Types.Typed
      Eclips.Application.Types.Value
      Eclips.Application.Types.Write
  hs-source-dirs:      src
  build-depends:
      base >=4.22 && <4.23,
      binary >=0.8.9 && <0.9,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      eclips-public-types >=0.1 && <0.2,
      text >=2.1.3 && <2.2
  default-language:    GHC2024

test-suite application-types-properties
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  other-modules:
      BinaryProperties
      BoundaryProperties
      IdentityProperties
      LifecycleProperties
      LifetimeProperties
      PrimordialProperties
      QueryProperties
      TypedProperties
      ValueProperties
  hs-source-dirs:      test
  ghc-options:
      -threaded
      -rtsopts
      "-with-rtsopts=-N4 -M768m"
  build-depends:
      base >=4.22 && <4.23,
      binary >=0.8.9 && <0.9,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      eclips-application-types,
      eclips-public-types >=0.1 && <0.2,
      tasty >=1.5 && <1.6,
      tasty-hunit >=0.10 && <0.11,
      tasty-quickcheck >=0.11 && <0.12,
      text >=2.1.3 && <2.2
  default-language:    GHC2024
