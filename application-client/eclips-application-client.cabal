cabal-version:      3.0
name:               eclips-application-client
version:            0.1.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
extra-doc-files:    README.md
author:             Erik Boasson
maintainer:         Erik Boasson <eb@ilities.com>
copyright:          2026 Erik Boasson
synopsis:           Pure application session and retry owner for ECLIPS
description:
    A deterministic application-side session owner covering open, reconnect,
    connection-scoped lifetime, explicit receipt retirement, paced opening retry, wait
    cancellation, and permanent loss. Encoding, transport, clocks, concurrency,
    and Herald semantics remain outside this package.
category:           Distributed

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wmissing-export-lists
      -Wredundant-constraints
      -Wpartial-fields
      -Wunused-packages
      -Werror=incomplete-patterns
      -Werror=missing-fields
      -Werror=missing-methods

library
  import:             warnings
  exposed-modules:
      Eclips.Application.Client
      Eclips.Application.Client.Effect
      Eclips.Application.Client.Input
      Eclips.Application.Client.Recovery
  other-modules:
      Eclips.Application.Client.Effect.Internal
      Eclips.Application.Client.Internal
      Eclips.Application.Client.Recovery.Internal
  hs-source-dirs:      src
  build-depends:
      base >=4.22 && <4.23,
      containers >=0.8 && <0.9,
      eclips-application-types >=0.1 && <0.2,
      eclips-public-types >=0.1 && <0.2,
      eclips-protocol-application >=0.1 && <0.2
  default-language:    GHC2024

test-suite application-client-properties
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Main.hs
  other-modules:
      ClientProperties
      LifecycleProperties
      ReceiptRetirementProperties
  hs-source-dirs:      test
  ghc-options:
      -threaded
      -rtsopts
      "-with-rtsopts=-N4 -M768m"
  build-depends:
      base >=4.22 && <4.23,
      bytestring >=0.12.2 && <0.13,
      containers >=0.8 && <0.9,
      eclips-application-client,
      eclips-application-types >=0.1 && <0.2,
      eclips-public-types >=0.1 && <0.2,
      eclips-protocol-application >=0.1 && <0.2,
      tasty >=1.5 && <1.6,
      tasty-hunit >=0.10 && <0.11,
      tasty-quickcheck >=0.11 && <0.12
  default-language:    GHC2024
